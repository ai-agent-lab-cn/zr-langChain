# 配置模板；复制为 .env 后填写真实密钥。不要覆盖已有 .env。
# 模型 ID 沿用仓库记录，本次未在线验证；运行前核对账号可用性。

# 第 01—07 章 Gemini 在线示例
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# 第 08—10 章 DeepSeek 在线示例
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# 默认不上传 Trace；需要时按对应章节说明显式开启。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=zr-langChain

# 第 11、12 章当前仅提供本地离线实验，不读取本文件。
